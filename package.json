{
  "name": "la-lml",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @lalml/db db:generate",
    "db:migrate": "pnpm --filter @lalml/db db:migrate",
    "db:seed": "pnpm --filter @lalml/db db:seed",
    "db:verify": "pnpm --filter @lalml/db db:verify",
    "shows:paste": "pnpm --filter @lalml/ingest shows:paste"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "turbo": "^2.11.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
