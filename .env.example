# Copy to .env (gitignored) and fill in. Never commit real values.
# Supabase dashboard > Connect shows both pooler strings.

# Transaction pooler (port 6543). Used by the API at runtime; prepared statements are turned off.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Session pooler (port 5432). Used by migrations (pnpm db:migrate) and the seed (pnpm db:seed).
DATABASE_URL_SESSION=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional: lets `pnpm db:verify` check that Supabase's own REST API is locked down.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
