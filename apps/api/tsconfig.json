{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Repeated from tsconfig.base.json on purpose. Vercel's Node builder fills in defaults on this file
    // before resolving "extends": if module is unset here it forces NodeNext, ES2021 and strict: false,
    // which breaks type-checking. Keep these three in this file.
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  },
  "include": ["src", "vitest.config.ts"]
}
